# Optional Microsoft Foundry-compatible endpoint. Leave unset for deterministic demo mode.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-10-21

# Optional football-data.org API token for real fixtures/results.
# Keep this server-side; never expose it as NEXT_PUBLIC_*.
FOOTBALL_DATA_API_TOKEN=
